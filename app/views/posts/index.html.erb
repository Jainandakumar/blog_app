<div class="posts-header">
  <h1>Blog Posts</h1>
  <%= link_to "New Post", new_post_path, class: "btn btn-primary" %>
</div>

<% if @posts.empty? %>
  <p>No posts yet. <%= link_to "Create the first one!", new_post_path %></p>
<% else %>
  <div class="posts-list">
    <% @posts.each do |post| %>
      <%= render post %>
    <% end %>
  </div>
<% end %>
