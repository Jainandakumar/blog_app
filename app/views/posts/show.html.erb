<article class="post-full">
  <h1><%= @post.title %></h1>
  <p class="post-meta">
    By <strong><%= @post.user.name %></strong> &mdash;
    <%= @post.created_at.strftime("%B %d, %Y at %H:%M") %>
  </p>
  <div class="post-body">
    <%= simple_format(@post.body) %>
  </div>

  <div class="post-actions">
    <%= link_to "Edit Post", edit_post_path(@post) %>
    &nbsp;|&nbsp;
    <%= button_to "Delete Post", post_path(@post), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this post?" }, class: "btn-link-danger" %>
    &nbsp;|&nbsp;
    <%= link_to "Back to Posts", posts_path %>
  </div>
</article>

<section class="comments-section">
  <h2><%= pluralize(@comments.size, "Comment") %></h2>

  <% if @comments.any? %>
    <div class="comments-list">
      <% @comments.each do |comment| %>
        <%= render partial: "comments/comment", locals: { comment: comment, post: @post } %>
      <% end %>
    </div>
  <% else %>
    <p class="no-comments">No comments yet. Be the first to comment!</p>
  <% end %>

  <div class="new-comment">
    <h3>Add a Comment</h3>
    <%= render "comments/form", post: @post, comment: @comment %>
  </div>
</section>
