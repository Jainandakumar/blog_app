<div class="post-card">
  <h1><%= @user.name %></h1>
  <p class="post-meta"><%= @user.email %></p>

  <div class="post-actions" style="margin-top: 1rem;">
    <%= link_to "Edit", edit_user_path(@user) %>
    &nbsp;|&nbsp;
    <%= button_to "Delete", @user, method: :delete, data: { turbo_confirm: "Delete this user and all their posts?" }, class: "btn-link-danger" %>
    &nbsp;|&nbsp;
    <%= link_to "Back to Users", users_path %>
  </div>
</div>

<section class="comments-section" style="margin-top: 1.5rem;">
  <h2><%= @user.name %>'s Posts (<%= @user.posts.size %>)</h2>

  <% if @user.posts.any? %>
    <div class="posts-list" style="margin-top: 1rem;">
      <% @user.posts.order(created_at: :desc).each do |post| %>
        <article class="post-card">
          <h3><%= link_to post.title, post_path(post) %></h3>
          <p class="post-meta"><%= post.created_at.strftime("%B %d, %Y") %> &mdash; <%= post.comments.size %> comment(s)</p>
          <p class="post-body"><%= truncate(post.body, length: 150) %></p>
        </article>
      <% end %>
    </div>
  <% else %>
    <p class="no-comments">This user has no posts yet.</p>
  <% end %>
</section>
